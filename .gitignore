# ─── Yocto build output ───────────────────────────────────────────────────────
build/
cache/
sstate-cache/
downloads/

# ─── KAS artefacts ────────────────────────────────────────────────────────────
.kas-cache/
kas-container

# ─── Yocto / BitBake generated files ─────────────────────────────────────────
layers/
bitbake.lock
pseudodone

# SDK installers
deploy/**/*.sh

# Compiled Python
*.pyc
*.pyo
__pycache__/

# ─── Docker artefacts ─────────────────────────────────────────────────────────
docker/**/*.tar
docker/**/*.tar.gz
docker/sdk/sdk.sh
docker/esdk/esdk.sh

# ─── SD card images (large) ───────────────────────────────────────────────────
*.wic
*.wic.bz2
*.wic.bmap
*.img
*.img.bz2

# ─── OTA / SWU artefacts ──────────────────────────────────────────────────────
*.swu
*.swu.sig

# SWUpdate signing keys — NEVER commit private keys
meta/*/swupdate/keys/swupdate-private.pem
**/*.pem
**/*.key
!meta/*/recipes-swupdate/*/files/swupdate-public.pem

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

deploy/

# meta/meta-vela is a nested clone with its own upstream
# (soccentric-vela/meta-vela.git), fetched by kas — never tracked here.
meta/*

# ─── Upstream Yocto layers checked out by kas at the repo root ──────────────
meta-arm/
meta-openembedded/
meta-qcom/
meta-swupdate/
poky/
