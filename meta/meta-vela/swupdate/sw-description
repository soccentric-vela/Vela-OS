software =
    {
        version = "@@VERSION@@";
        hardware- compatibility =["1.0"];

/*
 * Vela generic x86 — A/B rootfs OTA update
 *
 * Workflow:
 *   1. pre-install.sh identifies the inactive slot by rootfs label
 *      (rootfs-a <-> rootfs-b) and
 *      creates the /dev/swupdate-inactive symlink.
 *   2. The "raw" handler streams rootfs.ext4.gz onto that device.
 *   3. post-install.sh updates boot config under /boot so the new slot
 *      is selected on the next reboot, then cleans up temp files.
 *   4. SWUpdate triggers `reboot` via postupdatecmd in swupdate.cfg.
 *
 * To deliver the update:
 *   • Web UI  : http://<device-ip>:8080  (drag-and-drop .swu)
 *   • CLI push: swupdate-client -v <device-ip> vela-<version>.swu
 */

images: (
    {
        filename   = "rootfs.ext4.gz";
        type       = "raw";
        device     = "/dev/swupdate-inactive";
        compressed = "zlib";
    }
);

scripts: (
    {
        filename = "pre-install.sh";
        type     = "shellscript";
        data     = "preinst";
    },
    {
        filename = "post-install.sh";
        type     = "shellscript";
        data     = "postinst";
    }
);
};
