# Vela generic x86-64 SD card image — A/B OTA layout (EFI GPT)
#
# p1  /boot    512 MB   vfat    EFI System Partition
# p2  /        8192 MB  ext4    rootfs-a  (active slot, populated at build time)
# p3  <none>   8192 MB  ext4    rootfs-b  (standby slot, written by SWUpdate)
# p4  /home    512 MB → grows to fill card on first boot via vela-data-init

part /boot --source bootimg-efi --ondisk sda --fstype=vfat --label boot --active --align 4096 --fixed-size 512M

part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 8192M

part --source empty --ondisk sda --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 8192M

part /home --source empty --ondisk sda --fstype=ext4 --label home --align 4096 --fixed-size 512M
